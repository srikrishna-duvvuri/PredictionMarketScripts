# ── Kalshi ────────────────────────────────────────────────────────────────────
# Optional: improves rate limits and unlocks private market data.
# Get your key at https://kalshi.com/account/api
KALSHI_API_KEY=

# Set to "true" to hit the Kalshi demo environment instead of production.
KALSHI_USE_DEMO=false

# ── Scanner tuning ─────────────────────────────────────────────────────────────
# Minimum spread (as a decimal) to flag as a potential opportunity.
# 0.05 = 5 percentage points difference in YES price between exchanges.
SPREAD_THRESHOLD=0.05

# Minimum fuzzy-match similarity score (0–1) to consider two markets the same.
# Lower = more matches but more false positives.
# 0.65 is a good starting point; raise to 0.80+ for high-confidence only.
MATCH_SIMILARITY=0.65
